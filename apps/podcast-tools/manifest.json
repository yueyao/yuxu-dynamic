{
  "app_id": "podcast-tools",
  "release_digest": "transcribe-v1",
  "max_concurrency": 1,
  "tasks": [
    {
      "task_key": "audio/transcribe",
      "timeout_ms": 21600000,
      "max_attempts": 3,
      "input_schema": {
        "type": "object",
        "required": ["source_url"],
        "additionalProperties": false,
        "properties": {
          "source_url": {
            "type": "string",
            "minLength": 12,
            "maxLength": 2048,
            "pattern": "^https://www\\.xiaoyuzhoufm\\.com/episode/"
          },
          "language": { "type": "string", "enum": ["auto", "zh", "en"] },
          "timestamps": { "type": "string", "enum": ["none", "segment"] },
          "speaker_diarization": { "type": "boolean" },
          "output_format": { "type": "string", "enum": ["text", "markdown"] },
          "quality": { "type": "string", "enum": ["fast", "balanced", "accurate"] }
        }
      },
      "output_schema": {
        "type": "object",
        "required": [
          "artifact_id", "source_platform", "canonical_url", "title", "language",
          "duration_seconds", "segment_count", "format", "audio_sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "artifact_id": { "type": "string", "minLength": 1 },
          "source_platform": { "type": "string", "minLength": 1 },
          "canonical_url": { "type": "string", "minLength": 1 },
          "source_episode_id": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "language": { "type": "string", "minLength": 2 },
          "duration_seconds": { "type": "number", "minimum": 0 },
          "segment_count": { "type": "integer", "minimum": 1 },
          "format": { "type": "string", "enum": ["text", "markdown"] },
          "audio_sha256": { "type": "string", "minLength": 64, "maxLength": 64 }
        }
      }
    }
  ]
}
