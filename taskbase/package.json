{
  "name": "yuxun",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "玉虚个人远程任务平台 CLI 与 Mac 转写服务",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "server": "node src/main.ts",
    "bootstrap": "node src/bootstrap.ts",
    "cli": "node src/cli.ts",
    "worker:demo": "node src/worker-demo.ts",
    "test": "node --test test/*.test.ts",
    "web": "node web/main.ts",
    "worker:podcast": "node src/podcast/worker.ts",
    "seed:feeds": "node scripts/seed-feeds.ts",
    "worker:transcription": "node src/transcription/worker.ts",
    "mac:pair": "node scripts/mac-agent.ts pair",
    "mac:doctor": "node scripts/mac-agent.ts doctor",
    "mac:install": "node scripts/mac-agent.ts install",
    "mac:start": "node scripts/mac-agent.ts start",
    "mac:stop": "node scripts/mac-agent.ts stop",
    "mac:status": "node scripts/mac-agent.ts status",
    "mac:logs": "node scripts/mac-agent.ts logs",
    "mac:run": "node scripts/mac-agent.ts run",
    "mac:uninstall": "node scripts/mac-agent.ts uninstall",
    "install:global": "node scripts/install-global.ts",
    "yuxun": "node src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fast-xml-parser": "^5.12.0"
  },
  "files": [
    "src/",
    "scripts/",
    "web/",
    "demo/",
    "deploy/",
    "docs/",
    "package.json",
    "package-lock.json",
    "README.md"
  ],
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "25.5.0"
  }
}
